<Window x:Class="VideoWall.Agent.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="VideoWall Display"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black">
    <Grid x:Name="mainGrid">
        <!-- Layer 0: Background -->
        <Border x:Name="backgroundLayer" Background="Black"/>

        <!-- Layer 1: Previous content (for transitions) -->
        <Grid x:Name="previousContentLayer" Visibility="Collapsed">
            <Image x:Name="previousImage" Stretch="Uniform"/>
        </Grid>

        <!-- Layer 2: Current content -->
        <Grid x:Name="currentContentLayer">
            <!-- Video player -->
            <vlc:VideoView x:Name="videoView" Visibility="Collapsed"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           Background="Black"/>

            <!-- Image display -->
            <Image x:Name="imageDisplay" Stretch="Uniform" Visibility="Collapsed"/>

            <!-- Slideshow container -->
            <Grid x:Name="slideshowContainer" Visibility="Collapsed">
                <Image x:Name="slideImage" Stretch="Uniform"/>
            </Grid>

            <!-- Test pattern container -->
            <ContentControl x:Name="testPatternContainer" Visibility="Collapsed"/>
        </Grid>

        <!-- Layer 3: Transition overlay (for wipes) -->
        <Canvas x:Name="transitionLayer" Visibility="Collapsed"/>

        <!-- Layer 4: Output ID overlay (toggle with key) -->
        <Border x:Name="outputIdOverlay" Background="#AA000000" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="txtOutputId" Text="OUTPUT-ID" FontSize="48" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           FontFamily="Consolas"/>
                <TextBlock x:Name="txtResolution" Text="1920x1080" FontSize="24"
                           Foreground="#AAA" HorizontalAlignment="Center"
                           FontFamily="Consolas" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Debug/status overlay (hidden by default) -->
        <Border x:Name="debugOverlay" Background="#88000000" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="0,0,8,0" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="txtDebugStatus" Text="Status: Idle" Foreground="Lime" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="txtDebugPosition" Text="Position: --:--" Foreground="White" FontSize="12" FontFamily="Consolas"/>
                <TextBlock x:Name="txtDebugFps" Text="FPS: --" Foreground="White" FontSize="12" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
