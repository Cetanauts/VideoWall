<Window x:Class="VideoWall.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoWall Agent"
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VideoWall Agent" Style="{StaticResource HeaderText}" FontSize="24"/>
            <TextBlock x:Name="txtMachineInfo" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status Panel -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="statusIndicator" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtStatus" Text="Ready" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Server Port" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="txtPort" Text="5050" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Active Outputs" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="txtOutputCount" Text="0" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Outputs List -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Display Outputs" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

                <ListView x:Name="lstOutputs" Grid.Row="1"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource TextBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D1117" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status indicator -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Output info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OutputId}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Resolution}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>

                                    <!-- Current media -->
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentMedia}"
                                               Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Test" Padding="8,4" Margin="0,0,8,0"
                                                Click="TestOutput_Click" Tag="{Binding OutputId}"/>
                                        <ToggleButton x:Name="btnEnabled" Content="Enabled" Padding="8,4"
                                                      IsChecked="{Binding IsEnabled}"
                                                      Click="ToggleOutput_Click" Tag="{Binding OutputId}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Refresh Hardware" Click="RefreshHardware_Click" Margin="0,0,8,0"/>
            <Button Content="View Logs" Click="ViewLogs_Click" Margin="0,0,8,0"/>
            <Button x:Name="btnStartStop" Content="Stop Server" Click="StartStop_Click"/>
        </StackPanel>
    </Grid>
</Window>
