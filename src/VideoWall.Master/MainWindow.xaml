<Window x:Class="VideoWall.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoWall Master Controller"
        Height="900" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#E66FF0FF" Offset="0"/>
                                <GradientStop Color="#2635D4FF" Offset="0.55"/>
                                <GradientStop Color="#10FFFFFF" Offset="0.75"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VideoWall Master" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Multi-display video wall controller" Style="{StaticResource MutedStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status indicators -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="agentStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtAgentCount" Text="0 Agents" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtOutputCount" Text="0 Outputs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Header actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Add Agent" Style="{StaticResource PrimaryButton}" Click="AddAgent_Click" Margin="0,0,8,0"/>
                    <Button Content="Settings" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Screen Grid View -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Screen Grid" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtScreenSetName" Text=" - No Screen Set Selected"
                                   Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Screen preview grid -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                        <Grid x:Name="screenGrid" Margin="16">
                            <!-- Screens will be added dynamically -->
                            <TextBlock Text="Select a Screen Set or add agents to begin"
                                       Style="{StaticResource MutedStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Name="txtNoScreens"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right sidebar -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Screen Sets -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Screen Sets" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                            <Button Content="+" Padding="8,2" Margin="8,0,0,0" Click="AddScreenSet_Click"
                                    ToolTip="Create new screen set"/>
                        </StackPanel>

                        <ListBox x:Name="lstScreenSets" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 SelectionChanged="ScreenSet_SelectionChanged"
                                 MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource MutedStyle}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Padding="8,4"
                                                    Click="EditScreenSet_Click" Tag="{Binding ScreenSetId}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Agents List -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Connected Agents" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,12"/>

                        <ListBox x:Name="lstAgents" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ComputerName}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource MutedStyle}">
                                                    <Run Text="{Binding IpAddress}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding OutputCount}"/>
                                                    <Run Text=" outputs"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="..." Padding="8,4"
                                                    Click="AgentMenu_Click" Tag="{Binding MachineId}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Quick Actions -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,12"/>

                        <Button Content="Play Media on All..." Style="{StaticResource PrimaryButton}"
                                Click="PlayMediaOnAll_Click" Margin="0,0,0,8"
                                ToolTip="Select a media file and play it on all assigned outputs"/>
                        <Button Content="Resume All" Style="{StaticResource SuccessButton}"
                                Click="PlayAll_Click" Margin="0,0,0,8"/>
                        <Button Content="Pause All" Click="PauseAll_Click" Margin="0,0,0,8"/>
                        <Button Content="Stop All" Style="{StaticResource DangerButton}"
                                Click="StopAll_Click" Margin="0,0,0,8"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <Button Content="Test Sync Flash" Click="TestSyncFlash_Click" Margin="0,8,0,0"/>
                        <Button Content="Diagnostics" Click="Diagnostics_Click" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatusMessage" Text="Ready" Style="{StaticResource MutedStyle}"/>
                <TextBlock Grid.Column="1" x:Name="txtTime" Style="{StaticResource MutedStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
