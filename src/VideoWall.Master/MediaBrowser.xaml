<Window x:Class="VideoWall.Master.MediaBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Browser"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="600"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Path bar -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Up" Click="GoUp_Click" Padding="12,6" Margin="0,0,8,0"/>

                <TextBox Grid.Column="1" x:Name="txtPath" Text="\\server\share\media"
                         VerticalContentAlignment="Center" Padding="8,6"
                         KeyDown="PathTextBox_KeyDown"/>

                <Button Grid.Column="2" Content="Go" Click="Navigate_Click" Padding="12,6" Margin="8,0,0,0"/>

                <ComboBox Grid.Column="3" x:Name="cmbFilter" Width="120" Margin="8,0,0,0"
                          SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="All Media"/>
                    <ComboBoxItem Content="Videos Only"/>
                    <ComboBoxItem Content="Images Only"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Quick access / bookmarks -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Quick Access" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1" x:Name="lstQuickAccess" Background="Transparent" BorderThickness="0"
                             SelectionChanged="QuickAccess_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="📁" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- File list -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="txtItemCount" Text="0 items" Style="{StaticResource MutedStyle}"/>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="lstFiles" Background="Transparent" BorderThickness="0"
                              SelectionChanged="File_SelectionChanged"
                              MouseDoubleClick="File_DoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Width="24"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- Preview panel -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Preview" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,12"/>

                    <!-- Thumbnail -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                        <Image x:Name="imgPreview" Stretch="Uniform" Margin="8"/>
                    </Border>

                    <!-- File info -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="txtFileName" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtFileInfo" Style="{StaticResource MutedStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSelectedFile" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Select" Style="{StaticResource PrimaryButton}" Click="Select_Click"
                            Padding="16,8" x:Name="btnSelect" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
