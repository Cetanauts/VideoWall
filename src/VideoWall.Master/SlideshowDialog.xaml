<Window x:Class="VideoWall.Master.SlideshowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slideshow Settings"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configure Slideshow" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,16"/>

        <!-- Images List -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Image list header -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="12,8"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Images" Style="{StaticResource SubHeaderStyle}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Add Files..." Click="AddFiles_Click" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Add Folder..." Click="AddFolder_Click" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Clear" Click="ClearImages_Click" Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- Image list -->
                <ListBox Grid.Row="1" x:Name="lstImages" Background="Transparent" BorderThickness="0"
                         Margin="8" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="4" Width="40" Height="30">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Filename -->
                                    <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                               Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Remove button -->
                                    <Button Grid.Column="2" Content="X" Padding="6,2"
                                            Click="RemoveImage_Click" Tag="{Binding FilePath}"
                                            ToolTip="Remove this image"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <TextBlock x:Name="txtNoImages" Grid.Row="1"
                           Text="Click 'Add Files...' or 'Add Folder...' to add images"
                           Style="{StaticResource MutedStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Duration -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Duration per Slide" Style="{StaticResource MutedStyle}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbDuration" SelectedIndex="2">
                        <ComboBoxItem Content="2 seconds" Tag="2000"/>
                        <ComboBoxItem Content="3 seconds" Tag="3000"/>
                        <ComboBoxItem Content="5 seconds" Tag="5000"/>
                        <ComboBoxItem Content="10 seconds" Tag="10000"/>
                        <ComboBoxItem Content="15 seconds" Tag="15000"/>
                        <ComboBoxItem Content="30 seconds" Tag="30000"/>
                        <ComboBoxItem Content="60 seconds" Tag="60000"/>
                    </ComboBox>
                </StackPanel>

                <!-- Transition Type -->
                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                    <TextBlock Text="Transition Effect" Style="{StaticResource MutedStyle}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbTransition" SelectedIndex="1">
                        <ComboBoxItem Content="Cut (Instant)" Tag="0"/>
                        <ComboBoxItem Content="Fade" Tag="1"/>
                        <ComboBoxItem Content="Wipe Left" Tag="2"/>
                        <ComboBoxItem Content="Wipe Right" Tag="3"/>
                        <ComboBoxItem Content="Wipe Up" Tag="4"/>
                        <ComboBoxItem Content="Wipe Down" Tag="5"/>
                        <ComboBoxItem Content="Push Left" Tag="6"/>
                        <ComboBoxItem Content="Push Right" Tag="7"/>
                        <ComboBoxItem Content="Push Up" Tag="8"/>
                        <ComboBoxItem Content="Push Down" Tag="9"/>
                        <ComboBoxItem Content="Zoom In" Tag="10"/>
                        <ComboBoxItem Content="Zoom Out" Tag="11"/>
                        <ComboBoxItem Content="Dissolve" Tag="12"/>
                        <ComboBoxItem Content="Blur" Tag="13"/>
                        <ComboBoxItem Content="Random" Tag="14"/>
                    </ComboBox>
                </StackPanel>

                <!-- Transition Duration -->
                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="Transition Speed" Style="{StaticResource MutedStyle}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbTransitionDuration" SelectedIndex="1">
                        <ComboBoxItem Content="Fast (500ms)" Tag="500"/>
                        <ComboBoxItem Content="Normal (1s)" Tag="1000"/>
                        <ComboBoxItem Content="Slow (2s)" Tag="2000"/>
                        <ComboBoxItem Content="Very Slow (3s)" Tag="3000"/>
                    </ComboBox>
                </StackPanel>

                <!-- Loop checkbox -->
                <CheckBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="chkLoop" Content="Loop slideshow continuously"
                          IsChecked="True" Margin="0,16,0,0" Foreground="{StaticResource TextBrush}"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="txtImageCount" Text="0 images" Style="{StaticResource MutedStyle}"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0" Width="100"/>
            <Button x:Name="btnStart" Content="Start Slideshow" Style="{StaticResource PrimaryButton}"
                    Click="Start_Click" Padding="16,8" Width="140"/>
        </StackPanel>
    </Grid>
</Window>
